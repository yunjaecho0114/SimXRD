{
  "schema_version": "0.1",
  "status": "draft_controlled_baseline",
  "source": {
    "structure_db": "CrystDB.db",
    "selection_csv": "db_expansion/selected_1000_split_v1.csv",
    "selection_seed": 20261101,
    "structure_count": 1000,
    "samples_per_structure": 30,
    "expected_samples": 30000,
    "splits": {
      "train": 800,
      "test": 100,
      "validation": 100
    }
  },
  "xrd": {
    "two_theta_start_deg": 10.0,
    "two_theta_stop_exclusive_deg": 80.0,
    "step_deg": 0.02,
    "length": 3500,
    "dtype": "float64",
    "normalization": "max_100",
    "ideal": "pymatgen_stick_binned_to_grid"
  },
  "strain": {
    "label": "lattice_axis_length_rms",
    "definition": "sqrt(mean([strain_a**2, strain_b**2, strain_c**2]))",
    "shear_bound": 0.0,
    "sampling_method": "rejection_sampling",
    "base_seed": 20261101,
    "max_attempts": 500,
    "schedule": [
      {
        "name": "zero",
        "low": 0.0,
        "high": 0.0,
        "bound": 0.0,
        "count": 1
      },
      {
        "name": "very_low",
        "low": 0.0,
        "high": 0.001,
        "bound": 0.001,
        "count": 5
      },
      {
        "name": "low",
        "low": 0.001,
        "high": 0.002,
        "bound": 0.003,
        "count": 5
      },
      {
        "name": "low_mid",
        "low": 0.002,
        "high": 0.004,
        "bound": 0.006,
        "count": 5
      },
      {
        "name": "medium",
        "low": 0.004,
        "high": 0.006,
        "bound": 0.01,
        "count": 5
      },
      {
        "name": "high",
        "low": 0.006,
        "high": 0.008,
        "bound": 0.01,
        "count": 5
      },
      {
        "name": "very_high",
        "low": 0.008,
        "high": 0.01,
        "bound": 0.01,
        "count": 4
      }
    ]
  },
  "controlled_variables": {
    "grain_size_nm": 10.0,
    "grain_size_input_A": 100.0,
    "thermal_displacement_A": 0.0,
    "orientation_randomness_bound": 0.0,
    "background_order": 6,
    "background_ratio": 0.0,
    "noise_ratio": 0.0,
    "zero_shift_deg": 0.0,
    "detector_sample_distance_mm": 500.0,
    "simxrd_L": 50.0,
    "simxrd_H": 5.0,
    "simxrd_S": 2.5,
    "sim_model": "pymatgen",
    "xrd_mode": "reciprocal"
  },
  "storage": {
    "format": "numpy_npy_memmap",
    "ideal_xrd_shape": [
      1000,
      3500
    ],
    "perturbed_xrd_shape": [
      30000,
      3500
    ],
    "lattice_before_shape": [
      30000,
      3,
      3
    ],
    "lattice_after_shape": [
      30000,
      3,
      3
    ],
    "dtype": "float64",
    "metadata": [
      "structures.csv",
      "samples.csv"
    ]
  },
  "safety": {
    "fast_mapping": "db_expansion/fast_xrd_mapping.py",
    "axial_divergence_fix": "validated_in_memory_not_yet_integrated",
    "require_finite_xrd": true,
    "require_structure_level_split": true,
    "require_readback_validation": true
  }
}
